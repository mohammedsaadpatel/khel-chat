# Copy to .env and fill in. NEVER commit .env or the service account file.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Singapore host from the doc example; confirm on the Base URL page
NEXCONN_HOST=api.sg-light-api.com
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
